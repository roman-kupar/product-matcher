{
  "name": "article-enricher",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "service"
  ],
  "scripts": {
    "dev": "npm run dev:service & npm run dev:client",
    "dev:client": "npm run dev --workspace=client",
    "dev:service": "npm run dev --workspace=service",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=client",
    "build:service": "npm run build --workspace=service",
    "lint": "npm run lint --workspaces",
    "lint:client": "npm run lint --workspace=client",
    "lint:service": "npm run lint --workspace=service"
  }
}
